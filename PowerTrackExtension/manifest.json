{
  "manifest_version": 3,
  "name": "PowerTrack Assistant",
  "version": "1.1.0",
  "description": "Programmatic interaction with AE PowerTrack Web API - extract auth, monitor API calls, automate tasks",
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://apps.alsoenergy.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://apps.alsoenergy.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["scripts/injected.js"],
      "matches": ["https://apps.alsoenergy.com/*"]
    }
  ]
}
